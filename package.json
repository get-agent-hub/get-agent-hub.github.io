{
  "name": "agent-hub-guide",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "npm run build && node scripts/serve.mjs",
    "build": "node scripts/build.mjs",
    "icons": "node scripts/render-icons.mjs",
    "test": "npm run build && node --test",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "check": "npm run format:check && npm run lint && npm test",
    "docs:sync": "node scripts/sync-docs.mjs"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.14.0",
    "globals": "17.14.0",
    "prettier": "3.9.10"
  }
}
